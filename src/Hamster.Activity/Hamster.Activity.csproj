<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Hamster.Activity</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- le script du hook vit dans Hooks/ a la racine du depot : embarque, l'app peut le deposer -->
    <EmbeddedResource Include="..\..\Hooks\hook.sh" LogicalName="Hamster.Activity.hook.sh" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hamster.Activity.Tests" />
  </ItemGroup>
</Project>
